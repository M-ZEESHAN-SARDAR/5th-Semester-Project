# GEMINI_API_KEY: Required for Gemini AI recipe enhancement calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# SESSION_SECRET: Secret for signing session tokens (auto-generated in memory if omitted).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional admin setup passcode for claiming admin access.
ADMIN_PASSCODE=
